# ── Base de Datos ──
DATABASE_URL="file:./database/dev.db"
# PostgreSQL (Neon): DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/ovejita?sslmode=require"

# ── Servidor ──
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:4321
ADMIN_URL=http://localhost:5173

# ── Autenticación ──
JWT_SECRET=ovejita-dev-secret-cambiar-en-produccion-32chars
JWT_EXPIRES_IN=7d

# ── Almacenamiento ──
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./backend/uploads
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Seed / Admin inicial ──
ADMIN_EMAIL=admin@ovejitasorpresas.com
ADMIN_PASSWORD=OvejitaAdmin2025!
