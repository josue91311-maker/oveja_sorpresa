---
interface Props {
  text?: string;
}

const { text = "Ediciones con propósito · Dedicatoria & personalización" } = Astro.props;
---

<aside
  aria-label="Aviso especial"
  class="bg-gradient-to-r from-primary-soft via-secondary-pastel/60 to-primary-soft border-b border-border text-[11px] py-2 px-4 text-center font-medium text-plum flex items-center justify-center gap-1.5"
  data-purpose="announcement-bar"
>
  <span class="inline-block animate-bounce text-xs">✨</span>
  <span>{text}</span>
</aside>
