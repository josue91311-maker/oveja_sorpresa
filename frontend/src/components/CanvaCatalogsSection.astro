                    title="Pedir o consultar por WhatsApp"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
                    </svg>
                  </a>
                </div>
              </div>

            </div>
          </div>
        );
      })}

      <!-- Decorative Right Side (Logo Oficial Ovejita) -->
      <div class={`${catalogs.length === 4 ? 'hidden lg:flex' : 'flex'} flex-col items-center justify-center p-6 text-center select-none`}>
        <div class="relative group p-6 rounded-3xl bg-white border border-purple-100 shadow-xs flex flex-col items-center justify-center gap-3.5 max-w-[240px] transition-all hover:scale-105 hover:shadow-md w-full">
          <div class="w-24 h-24 rounded-2xl overflow-hidden border border-purple-100/90 shadow-2xs p-1 bg-white flex items-center justify-center">
            <img
              src={logoUrl}
              alt="Ovejita Sorpresas"
              class="w-full h-full object-cover rounded-xl group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="space-y-0.5">
            <h4 class="text-sm font-bold text-[#1D1930] tracking-tight font-brand">Ovejita Sorpresas</h4>
            <p class="text-[11px] text-[#71809A] font-light">Tienda de Regalos con Propósito</p>
          </div>
        </div>
      </div>

    </div>

  </div>

  <!-- Client-side Live Sync to display uploaded photos immediately in any environment -->
  <script is:inline>
    (async function syncCanvaCatalogsLive() {
      try {
        let liveSettings = null;
        // 1. Try public API first
        try {
          const res = await fetch((window.PUBLIC_API_URL || '') + '/api/settings');
          if (res.ok) {
            const json = await res.json();
            liveSettings = json.data;
          }
        } catch (e) {}

        // 2. Direct Supabase REST fallback if API is not available
        if (!liveSettings || !liveSettings.generalTexts) {
          try {
            const sbUrl = 'https://smxqqetxawatlnrttapw.supabase.co/rest/v1/BusinessSettings?select=*';
            const anon = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNteHFxZXR4YXdhdGxucnR0YXB3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1NzY2OTUsImV4cCI6MjEwNTE1MjY5NX0.ylCqYbxeswEWkuDZLdUGQzZNotxA5GCRaICeleyOxpQ';
            const sbRes = await fetch(sbUrl, {
              headers: { 'apikey': anon, 'Authorization': 'Bearer ' + anon }
            });
            if (sbRes.ok) {
              const arr = await sbRes.json();
              if (arr && arr[0]) {
                liveSettings = {
                  ...arr[0],
                  generalTexts: typeof arr[0].generalTexts === 'string' ? JSON.parse(arr[0].generalTexts) : arr[0].generalTexts
                };
              }
            }
          } catch (e) {}
        }

        const cats = liveSettings?.generalTexts?.canvaCatalogs;
        if (Array.isArray(cats) && cats.length > 0) {
          cats.forEach((cat, idx) => {
            if (!cat) return;
            if (cat.imageUrl) {
              const imgEl = document.querySelector(`[data-catalog-img="${idx}"]`);
              if (imgEl && imgEl.getAttribute('src') !== cat.imageUrl) {
                imgEl.src = cat.imageUrl;
              }
            }
            if (cat.title) {
              const titleEl = document.querySelector(`[data-catalog-title="${idx}"]`);
              if (titleEl) {
                const cleanTitle = cat.title.replace(/[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F900}-\u{1F9FF}\u{1F1E0}-\u{1F1FF}]/gu, '').trim();
                if (titleEl.textContent.trim() !== cleanTitle) {
                  titleEl.textContent = cleanTitle;
                }
              }
            }
            if (cat.url) {
              const linkEl = document.querySelector(`[data-catalog-link="${idx}"]`);
              if (linkEl && linkEl.getAttribute('href') !== cat.url) {
                linkEl.href = cat.url;
              }
            }
          });
        }
