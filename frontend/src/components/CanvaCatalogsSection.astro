              <!-- Content and Button Row -->
              <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mt-auto">
                <div>
                  <h3
                    data-catalog-title={idx}
                    class="text-lg sm:text-xl font-brand font-bold leading-snug"
                    style={`color: ${catalog.colors.text};`}
                  >
                    {catalog.title}
                  </h3>
                </div>

                <!-- Action Button & WhatsApp Direct Shortcut -->
                <div class="flex items-center gap-2 shrink-0 pt-2 sm:pt-0">
                  <!-- Main Pill Button: Ver catálogo → -->
                  <a
                    data-catalog-link={idx}
