const rawCatalogs = (settings?.generalTexts?.canvaCatalogs && Array.isArray(settings.generalTexts.canvaCatalogs) && settings.generalTexts.canvaCatalogs.length > 0)
  ? settings.generalTexts.canvaCatalogs
  : defaultCanvaCatalogs;

const catalogs = rawCatalogs.map((item: any, idx: number) => {
  const pal = colorPalettes[idx % colorPalettes.length];
  const customColor = item.color || item.colors?.primary;

  const colors = item.colors || (customColor ? {
    ...pal,
    primary: customColor,
    primaryHover: customColor,
    icon: customColor,
  } : pal);

  return {
    ...item,
    id: item.id || `cat_${idx + 1}`,
    title: (item.title || `Catálogo ${idx + 1}`).replace(/[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F900}-\u{1F9FF}\u{1F1E0}-\u{1F1FF}]/gu, '').trim(),
    desc: item.desc || '',
    url: item.url || '#',
    imageUrl: item.imageUrl || `/images/catalogos/catalogo_${(idx % 4) + 1}.png`,
    waMessage: item.waMessage || `Hola Ovejita Sorpresas, vi su catálogo de ${item.title || ''} y deseo más información.`,
    colors,
  };
});

const canvaHeroTag = settings?.generalTexts?.canvaHeroTag || "✦ Regalos que inspiran ✦";
const canvaHeroTitle = settings?.generalTexts?.canvaHeroTitle || "Explora Nuestras Colecciones";
const canvaHeroSubtitle = settings?.generalTexts?.canvaHeroSubtitle || "Descubre nuestros catálogos digitales interactivos en alta resolución. Hojéalos cómodamente y solicita tu detalle personalizado con empaque de regalo.";
const canvaHeroImageUrl = settings?.generalTexts?.canvaHeroImageUrl || "/images/catalogos/hero_gift_box.png";
const hideHeroOnMobile = settings?.generalTexts?.hideCanvaHeroOnMobile !== false;
const logoUrl = settings?.logoUrl || "/images/LOGO.jpg";
---

<section class="py-8 sm:py-14 bg-white" id="catalogos-digitales">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header: Configurable in admin, hidden on mobile by default, shown on web/desktop -->
