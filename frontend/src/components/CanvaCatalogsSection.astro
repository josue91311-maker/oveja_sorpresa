      <!-- Subtle organic background curves -->
      <div class="absolute -right-16 -top-16 w-80 h-80 bg-purple-100/40 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute left-1/3 -bottom-10 w-64 h-64 bg-pink-100/30 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left Text Content -->
        <div class="lg:col-span-8 space-y-3.5">
          <div class="inline-flex items-center gap-2 text-sm sm:text-base font-medium text-[#D96B91] tracking-wide font-brand">
            <span class="font-brand font-bold text-[#D96B91] text-base sm:text-lg">{canvaHeroTag}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-brand font-bold text-[#1D1930] tracking-tight leading-tight">
            {canvaHeroTitle}
          </h1>

          <p class="text-xs sm:text-sm md:text-base text-[#71809A] font-light max-w-xl leading-relaxed">
            {canvaHeroSubtitle}
          </p>
        </div>

        <!-- Right Hero Gift Box Image -->
        <div class="lg:col-span-4 flex items-center justify-center lg:justify-end">
          <div class="relative group">
            <img
              src={canvaHeroImageUrl}
              alt={canvaHeroTitle}
              class="max-h-48 sm:max-h-56 lg:max-h-60 w-auto object-contain drop-shadow-xl group-hover:scale-105 group-hover:rotate-1 transition-all duration-300"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>

    <!-- Catalogs Grid: 3 in top row, 1 wide in bottom row -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-7 max-w-7xl mx-auto">
      
      {catalogs.map((catalog: any, idx: number) => {
        const isWide = catalogs.length === 4 && idx === 3; // When 4 catalogs, keep Amor & Aniversarios wide like original mockup

        return (
