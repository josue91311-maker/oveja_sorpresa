              style={`background-color: ${catalog.colors.background};`}
            >
              <!-- Centered transparent PNG item -->
              <img
                data-catalog-img={idx}
                src={catalog.imageUrl}
                alt={catalog.title}
                class={`${isWide ? 'max-h-48 sm:max-h-56' : 'max-h-44 sm:max-h-52'} w-auto object-contain drop-shadow-md group-hover:scale-105 transition-transform duration-300 relative z-10 rounded-xl`}
