---
interface Props {
  categories?: any[];
  campaigns?: any[];
}

const { categories = [], campaigns = [] } = Astro.props;
---

<section class="py-4" data-purpose="catalog-filters">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 pb-2 text-xs">
      <button
        class="filter-btn active px-4 sm:px-5 py-2 sm:py-2.5 rounded-full font-brand font-bold bg-primary text-white shadow-soft transition-transform duration-200 hover:scale-105 whitespace-nowrap flex items-center gap-1.5 cursor-pointer"
        data-filter="all"
      >
        <span>🌸 Todos los Detalles</span>
      </button>

      {campaigns.map((camp) => (
        <a
          href={`/campana/${camp.slug}`}
          class="px-4 sm:px-5 py-2 sm:py-2.5 rounded-full font-brand font-bold bg-pink-50 text-secondary border border-secondary/40 hover:bg-secondary hover:text-white transition-all whitespace-nowrap flex items-center gap-1 shadow-2xs cursor-pointer"
          title="Ver catálogo de esta campaña"
        >
          <span>✨ {camp.name}</span>
          <span class="text-[10px] opacity-75">↗</span>
        </a>
      ))}

      {categories.map((cat) => (
        <button
          class="filter-btn px-4 sm:px-5 py-2 sm:py-2.5 rounded-full font-brand font-bold bg-white text-plum border border-border hover:border-primary hover:text-primary transition-all whitespace-nowrap cursor-pointer shadow-2xs"
          data-filter={cat.slug}
        >
          <span>{cat.name}</span>
        </button>
      ))}
    </div>
  </div>
</section>

