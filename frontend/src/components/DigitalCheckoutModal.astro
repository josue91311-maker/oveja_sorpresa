---
interface Props {
  settings?: any;
}

const { settings = {} } = Astro.props;
const rawWa = settings?.whatsappNumber || "992750599";
let whatsappNumber = String(rawWa).replace(/\D/g, '');
if (whatsappNumber.length === 9 && whatsappNumber.startsWith('9')) {
  whatsappNumber = '51' + whatsappNumber;
}
---

<!-- Digital Checkout Backdrop Overlay -->
<div
  id="digitalCheckoutOverlay"
  class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<!-- Digital Checkout Modal Container -->
<div
  id="digitalCheckoutModal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 transition-all duration-300 opacity-0 pointer-events-none scale-95"
  role="dialog"
  aria-modal="true"
  aria-labelledby="digitalModalTitle"
  data-whatsapp={whatsappNumber}
>
  <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl border border-purple-100/80 overflow-hidden flex flex-col max-h-[92vh]">
    
    <!-- Modal Header -->
    <div class="p-4 sm:p-5 border-b border-border/80 flex items-center justify-between bg-gradient-to-r from-purple-50/70 via-purple-50/30 to-pink-50/40">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-white border border-purple-100 flex items-center justify-center text-primary shadow-2xs">
          <svg class="w-5 h-5 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </div>
        <div>
          <h3 id="digitalModalTitle" class="font-serif font-bold text-base sm:text-lg text-ink leading-tight">
            Checkout de Diseños Digitales
          </h3>
          <span class="inline-flex items-center gap-1.5 text-[10px] sm:text-[10.5px] text-primary font-bold uppercase tracking-wider font-brand mt-0.5">
            <svg class="w-3.5 h-3.5 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Entrega Inmediata · Sin costo de envío</span>
          </span>
        </div>
      </div>

      <button
        id="closeDigitalModalBtn"
        type="button"
        class="w-8 h-8 rounded-full bg-white hover:bg-slate-100 text-slate-400 hover:text-ink flex items-center justify-center transition-colors border border-border shadow-2xs cursor-pointer"
        aria-label="Cerrar ventana"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-5">
      
      <!-- STATE 1: CHECKOUT FORM & PAYMENT SELECTION -->
      <div id="digitalCheckoutFormState" class="space-y-5">
        
        <!-- Product Card Summary -->
        <div class="p-3.5 rounded-2xl bg-[#FAF8FB] border border-border/80 flex items-center gap-3.5 shadow-2xs">
          <img
            id="digitalProductThumb"
            src="/images/LOGO.jpg"
            alt="Diseño digital"
            class="w-14 h-14 rounded-xl object-cover border border-purple-100 shrink-0"
          />
          <div class="min-w-0 flex-1">
            <span class="text-[10px] uppercase font-bold text-primary tracking-wider block font-brand">Diseño Imprimible</span>
            <h4 id="digitalProductName" class="text-xs sm:text-sm font-bold text-ink truncate leading-tight">
              Cargando diseño...
            </h4>
            <div class="flex items-center gap-2 text-[11px] text-slate-500 mt-1">
              <span class="inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>Formato PDF (300 DPI)</span>
              </span>
              <span>•</span>
              <span class="font-bold text-primary font-brand text-xs sm:text-sm" id="digitalProductPrice">S/ 0.00</span>
            </div>
          </div>
        </div>

        <!-- Form fields: Delivery info -->
        <div class="space-y-3">
          <div>
            <label for="digitalCustomerEmail" class="block text-xs font-bold text-ink mb-1 font-brand">
              Tu Correo Electrónico * <span class="text-slate-400 font-normal font-sans">(Aquí recibirás el enlace de descarga)</span>
            </label>
            <input
              id="digitalCustomerEmail"
              type="email"
              required
              placeholder="ejemplo@correo.com"
              class="w-full text-xs p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:bg-white focus:outline-none transition-all placeholder:text-slate-400 font-medium"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="digitalCustomerName" class="block text-xs font-semibold text-slate-700 mb-1 font-brand">
                Nombre del Comprador
              </label>
              <input
                id="digitalCustomerName"
                type="text"
                placeholder="Tu nombre"
                class="w-full text-xs p-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:bg-white focus:outline-none transition-all placeholder:text-slate-400"
              />
            </div>

            <div>
              <label for="digitalCustomerPhone" class="block text-xs font-semibold text-slate-700 mb-1 font-brand">
                WhatsApp <span class="text-slate-400 font-normal font-sans">(Opcional)</span>
              </label>
              <input
                id="digitalCustomerPhone"
                type="tel"
                placeholder="987654321"
                class="w-full text-xs p-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:bg-white focus:outline-none transition-all placeholder:text-slate-400"
              />
            </div>
          </div>
        </div>

        <!-- Payment Method Selector (Ready for Gateway) -->
        <div class="space-y-2 pt-2 border-t border-slate-100">
          <label class="block text-xs font-bold text-ink font-brand">
            Selecciona Método de Pago
          </label>

          <div class="space-y-2">
            <!-- Yape / Plin Option -->
            <label class="flex items-center justify-between p-3 rounded-2xl border border-purple-200 bg-purple-50/40 hover:bg-purple-50/70 transition-all cursor-pointer group">
              <div class="flex items-center gap-3">
                <input
                  type="radio"
                  name="digitalPaymentMethod"
                  value="YAPE"
                  checked
                  class="text-primary focus:ring-primary"
                />
                <div class="w-8 h-8 rounded-xl bg-purple-100 text-primary flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold text-ink block group-hover:text-primary transition-colors">Yape / Plin (Pago Móvil Rápido)</span>
                  <span class="text-[10px] text-slate-400 font-light block">Confirmación instantánea</span>
                </div>
              </div>
              <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">Recomendado</span>
            </label>

            <!-- Card Option -->
            <label class="flex items-center justify-between p-3 rounded-2xl border border-slate-200 hover:border-purple-200 hover:bg-slate-50/70 transition-all cursor-pointer group">
              <div class="flex items-center gap-3">
                <input
                  type="radio"
                  name="digitalPaymentMethod"
                  value="CARD"
                  class="text-primary focus:ring-primary"
                />
                <div class="w-8 h-8 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center shrink-0 group-hover:bg-purple-100 group-hover:text-primary transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold text-ink block group-hover:text-primary transition-colors">Tarjeta de Débito / Crédito</span>
                  <span class="text-[10px] text-slate-400 font-light block">Visa, Mastercard, American Express</span>
                </div>
              </div>
              <span class="text-[10px] text-slate-400 font-mono">Pasarela Segura</span>
            </label>

            <!-- PagoEfectivo Option -->
            <label class="flex items-center justify-between p-3 rounded-2xl border border-slate-200 hover:border-purple-200 hover:bg-slate-50/70 transition-all cursor-pointer group">
              <div class="flex items-center gap-3">
                <input
                  type="radio"
                  name="digitalPaymentMethod"
                  value="PAGOEFECTIVO"
                  class="text-primary focus:ring-primary"
                />
                <div class="w-8 h-8 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center shrink-0 group-hover:bg-purple-100 group-hover:text-primary transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold text-ink block group-hover:text-primary transition-colors">Banca por Internet / Agentes</span>
                  <span class="text-[10px] text-slate-400 font-light block">Código CIP en BCP, BBVA, Interbank</span>
                </div>
              </div>
            </label>
          </div>

          <!-- Gateway Architecture Notice -->
          <div class="p-3 rounded-xl bg-purple-50/50 border border-purple-100 text-[11px] text-slate-600 flex items-start gap-2.5 mt-2">
            <div class="w-6 h-6 rounded-lg bg-purple-100 text-primary flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="leading-relaxed">
              <strong>Arquitectura lista para Pasarela:</strong> El sistema validará el pago y entregará el enlace de descarga instantáneo. En este momento está activo en <strong>Modo Simulación</strong> para que puedas probar la experiencia completa sin costo de pasarela.
            </p>
          </div>
        </div>

        <!-- Submit Pay Button -->
        <div class="pt-2">
          <button
            id="digitalConfirmPayBtn"
            type="button"
            class="w-full py-4 bg-primary hover:bg-primary-dark text-white text-xs font-bold uppercase tracking-wider rounded-2xl transition-all shadow-soft flex items-center justify-center gap-2 cursor-pointer active:scale-98 font-brand"
          >
            <svg id="digitalPayBtnLockIcon" class="w-4 h-4 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
            <svg id="digitalPayBtnSpinner" class="hidden w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="digitalPayBtnText">Pagar y Obtener Descarga Inmediata</span>
          </button>
        </div>

      </div>

      <!-- STATE 2: SUCCESS & IMMEDIATE DOWNLOAD (Shown after payment) -->
      <div id="digitalSuccessState" class="space-y-5 hidden text-center">
        <div class="w-16 h-16 mx-auto rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center shadow-soft">
          <svg class="w-8 h-8 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>

        <div class="space-y-1">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-3.5 py-1 rounded-full border border-emerald-200 font-brand">
            <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Pago Confirmado con Éxito</span>
          </span>
          <h3 class="text-xl font-serif font-bold text-ink pt-1.5">
            ¡Tu diseño digital ya está listo!
          </h3>
          <p class="text-xs text-slate-500 font-light max-w-sm mx-auto">
            Hemos registrado tu compra y asignado tu archivo en alta resolución para descarga inmediata.
          </p>
        </div>

        <!-- Download Card -->
        <div class="p-5 rounded-3xl bg-gradient-to-br from-emerald-50/70 via-white to-purple-50/40 border border-emerald-200 text-left space-y-3.5 shadow-soft">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <div>
                <h4 id="successFileName" class="text-xs font-bold text-ink">
                  diseno-imprimible.pdf
                </h4>
                <span class="text-[10.5px] text-slate-400 font-light block">
                  Listo para imprimir en A4 / A5
                </span>
              </div>
            </div>
            <span class="text-xs text-emerald-700 font-bold bg-white px-2.5 py-1 rounded-full border border-emerald-100 font-brand">
              Listo
            </span>
          </div>

          <!-- PRIMARY DOWNLOAD BUTTON -->
          <a
            id="successDownloadBtn"
            href="#"
            download
            target="_blank"
            class="w-full py-3.5 px-6 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider rounded-2xl transition-all shadow-md flex items-center justify-center gap-2.5 hover:scale-[1.02] active:scale-95 font-brand"
          >
            <svg class="w-4 h-4 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Descargar Archivo PDF Ahora</span>
          </a>

          <!-- Printing Tips -->
          <div class="pt-2 border-t border-emerald-100/70 text-[11px] text-slate-600 space-y-1">
            <span class="font-bold block text-slate-700 font-brand">Consejos para la mejor impresión:</span>
            <p class="text-slate-500 font-light leading-relaxed">
              • Imprime en escala al 100% (tamaño real).<br />
              • Recomendamos usar papel Bond 90g o Cartulina Opalina de 180g para un acabado profesional.
            </p>
          </div>
        </div>

        <!-- WhatsApp Backup Button -->
        <div class="pt-1">
          <a
            id="successWhatsAppBtn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold rounded-full transition-colors border border-emerald-200"
          >
            <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
            </svg>
            <span>Enviar comprobante a mi WhatsApp</span>
          </a>
        </div>

        <div class="pt-2">
          <button
            id="finishDigitalModalBtn"
            type="button"
            class="text-xs text-slate-400 hover:text-ink font-semibold underline cursor-pointer"
          >
            Cerrar ventana
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<script is:inline>
  (function () {
    let currentDigitalProduct = null;

    const overlay = document.getElementById('digitalCheckoutOverlay');
    const modal = document.getElementById('digitalCheckoutModal');
    const closeBtn = document.getElementById('closeDigitalModalBtn');
    const finishBtn = document.getElementById('finishDigitalModalBtn');

    const formState = document.getElementById('digitalCheckoutFormState');
    const successState = document.getElementById('digitalSuccessState');

    const thumbEl = document.getElementById('digitalProductThumb');
    const nameEl = document.getElementById('digitalProductName');
    const priceEl = document.getElementById('digitalProductPrice');

    const emailInput = document.getElementById('digitalCustomerEmail');
    const nameInput = document.getElementById('digitalCustomerName');
    const phoneInput = document.getElementById('digitalCustomerPhone');

    const confirmPayBtn = document.getElementById('digitalConfirmPayBtn');
    const payBtnText = document.getElementById('digitalPayBtnText');
    const payBtnLockIcon = document.getElementById('digitalPayBtnLockIcon');
    const payBtnSpinner = document.getElementById('digitalPayBtnSpinner');

    const successFileName = document.getElementById('successFileName');
    const successDownloadBtn = document.getElementById('successDownloadBtn');
    const successWhatsAppBtn = document.getElementById('successWhatsAppBtn');

    function openModal(productData) {
      currentDigitalProduct = productData;

      // Populate summary
      if (thumbEl) thumbEl.src = productData.img || '/images/LOGO.jpg';
      if (nameEl) nameEl.textContent = productData.name || 'Diseño en PDF';
      if (priceEl) priceEl.textContent = `S/ ${Number(productData.price || 15).toFixed(2)}`;

      // Reset to form state
      formState?.classList.remove('hidden');
      successState?.classList.add('hidden');

      if (payBtnText) payBtnText.textContent = `Pagar S/ ${Number(productData.price || 15).toFixed(2)} y Descargar`;
      if (payBtnLockIcon) payBtnLockIcon.classList.remove('hidden');
      if (payBtnSpinner) payBtnSpinner.classList.add('hidden');
      if (confirmPayBtn) confirmPayBtn.disabled = false;

      // Show modal
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      overlay?.classList.add('opacity-100');

      modal?.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
      modal?.classList.add('opacity-100', 'scale-100');
      document.body.style.overflow = 'hidden';

      setTimeout(() => emailInput?.focus(), 150);
    }

    function closeModal() {
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      overlay?.classList.remove('opacity-100');

      modal?.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
      modal?.classList.remove('opacity-100', 'scale-100');
      document.body.style.overflow = '';
    }

    // Expose global open helper
    window.openDigitalCheckout = openModal;

    // Attach to triggers on page
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.open-digital-checkout-btn');
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        const pId = btn.getAttribute('data-product-id');
        const pName = btn.getAttribute('data-product-name');
        const pPrice = btn.getAttribute('data-product-price');
        const pImg = btn.getAttribute('data-product-img');
        const pFile = btn.getAttribute('data-product-file');
        const pFilename = btn.getAttribute('data-product-filename');

        openModal({
          id: pId,
          name: pName,
          price: pPrice,
          img: pImg,
          fileUrl: pFile,
          fileName: pFilename,
        });
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    finishBtn?.addEventListener('click', closeModal);
    overlay?.addEventListener('click', closeModal);

    // Process Simulated Gateway Payment
    confirmPayBtn?.addEventListener('click', async () => {
      const email = emailInput?.value?.trim();
      if (!email || !email.includes('@')) {
        alert('Por favor ingresa un correo electrónico válido para enviarte el enlace de descarga.');
        emailInput?.focus();
        return;
      }

      const paymentMethod = document.querySelector('input[name="digitalPaymentMethod"]:checked')?.value || 'YAPE';
      const customerName = nameInput?.value?.trim() || 'Cliente';
      const customerPhone = phoneInput?.value?.trim() || '';

      // Set loading state
      if (confirmPayBtn) confirmPayBtn.disabled = true;
      if (payBtnLockIcon) payBtnLockIcon.classList.add('hidden');
      if (payBtnSpinner) payBtnSpinner.classList.remove('hidden');
      if (payBtnText) payBtnText.textContent = 'Conectando con pasarela de pago...';

      try {
        const apiEndpoint = (window.PUBLIC_API_URL || '') + '/api/digital/orders/create';
        const res = await fetch(apiEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: currentDigitalProduct?.id,
            customerEmail: email,
            customerName,
            customerPhone,
            paymentMethod,
          }),
        });

        const data = await res.json();

        // Simulate 1.2s gateway verification
        setTimeout(() => {
          const downloadUrl = data.order?.downloadUrl || currentDigitalProduct?.fileUrl || '/uploads/pdfs/test-diseno.pdf';
          const fileName = data.order?.fileName || currentDigitalProduct?.fileName || 'test-diseno.pdf';

          if (successFileName) successFileName.textContent = fileName;
          if (successDownloadBtn) {
            successDownloadBtn.href = downloadUrl;
            successDownloadBtn.setAttribute('download', fileName);
          }

          // WhatsApp link
          const rawWa = modal?.getAttribute('data-whatsapp') || '992750599';
          let waBusiness = String(rawWa).replace(/\D/g, '');
          if (waBusiness.length === 9 && waBusiness.startsWith('9')) {
            waBusiness = '51' + waBusiness;
          }
          const waText = encodeURIComponent(
            `Hola Ovejita Sorpresas 🌸, he realizado la compra digital de "${currentDigitalProduct?.name}". Mi correo es: ${email}. Orden: ${data.order?.orderNumber || 'OVEJITA-PDF'}`
          );
          if (successWhatsAppBtn) {
            successWhatsAppBtn.href = `https://wa.me/${waBusiness}?text=${waText}`;
          }

          // Show success view
          formState?.classList.add('hidden');
          successState?.classList.remove('hidden');

          // Trigger confetti or toast if available
          if (window.showToast) {
            window.showToast('¡Pago confirmado! Tu diseño está listo para descargar.');
          }
        }, 1200);

      } catch (err) {
        alert('Error de conexión con la pasarela. Intenta nuevamente.');
        if (confirmPayBtn) confirmPayBtn.disabled = false;
        if (payBtnLockIcon) payBtnLockIcon.classList.remove('hidden');
        if (payBtnSpinner) payBtnSpinner.classList.add('hidden');
        if (payBtnText) payBtnText.textContent = 'Pagar y Obtener Descarga Inmediata';
      }
    });

  })();
</script>
