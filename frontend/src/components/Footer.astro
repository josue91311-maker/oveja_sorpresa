---
interface Props {
  settings?: any;
}

const { settings = {} } = Astro.props;

const logoUrl = settings?.logoUrl || '/images/LOGO.jpg';
const businessName = settings?.businessName || 'Ovejita Sorpresas';
const instagram = settings?.instagram || 'https://instagram.com/ovejitasorpresas';

const footer = settings?.generalTexts?.footer || {};

// Granular visibility settings
const hideFooter = footer.hideFooter === true;
const showDescription = footer.showDescription !== false;
const showLocationText = footer.showLocationText !== false;
const showCollections = footer.showCollections !== false;
const showCustomerService = footer.showCustomerService !== false;
const showClub = footer.showClub !== false;
const showBottomBar = footer.showBottomBar !== false;

const footerDescription = footer.description ||
  'Creamos papelería y regalos con intención y devoción. Cada detalle es empacado con amor para edificar y alegrar el corazón de quien lo recibe.';

const locationText = footer.locationText ||
  '✦ Sedes de taller creativo en Lima con despachos con amor a todo el Perú.';

const collectionsTitle = footer.collectionsTitle || 'Colecciones';
const collectionsLinks = footer.collectionsLinks && footer.collectionsLinks.length > 0
  ? footer.collectionsLinks
  : [
      { label: 'Cuadernos Salmos & Promesas', url: '/catalogo' },
      { label: 'Sets con Espejo y Llavero', url: '/catalogo' },
      { label: 'Devocionales Diarios', url: '/catalogo' },
      { label: 'Bolígrafos y Papelería Pastel', url: '/catalogo' },
    ];

const customerServiceTitle = footer.customerServiceTitle || 'Servicio al Cliente';
const customerServiceLinks = footer.customerServiceLinks && footer.customerServiceLinks.length > 0
  ? footer.customerServiceLinks
  : [
      { label: 'Tiempos de Despacho & Tarifas', url: '/#empaque-calidad' },
      { label: 'Guía de Cuidado de Papelería', url: '/#empaque-calidad' },
      { label: 'Garantía de Satisfacción Taller', url: '/#empaque-calidad' },
      { label: 'Ventas Corporativas & Eventos', url: '/#corporativo' },
    ];

const clubTitle = footer.clubTitle || 'Club Ovejita';
const clubSubtitle = footer.clubSubtitle || 'Recibe versículos semanales y acceso previo a nuevas colecciones.';
const clubButtonText = footer.clubButtonText || 'Unirme al Club';
const copyrightText = footer.copyrightText || 'Hecho con amor y bendición.';

// Dynamic column layout
const activeColsCount = (showCollections ? 1 : 0) + (showCustomerService ? 1 : 0) + (showClub ? 1 : 0);
const gridLayoutClass = activeColsCount === 3
  ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-5'
  : activeColsCount === 2
  ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4'
  : activeColsCount === 1
  ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
  : 'grid-cols-1 max-w-xl mx-auto text-center';
---

<footer
  id="mainFooterContainer"
  class={`bg-white border-t border-border pt-16 pb-24 sm:pb-12 text-slate-600 ${hideFooter ? 'hidden' : ''}`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="footerGridContainer" class={`grid ${gridLayoutClass} gap-10 mb-12`}>
      <!-- Brand & Logo (Col 1-2) -->
      <div class={`space-y-4 ${activeColsCount > 0 ? 'lg:col-span-2' : 'col-span-full flex flex-col items-center text-center'}`}>
        <div class="flex items-center space-x-3">
          <div class="h-12 w-12 rounded-full overflow-hidden border border-border p-0.5 bg-primary-soft/40 shadow-xs shrink-0">
            <img alt={businessName} class="h-full w-full object-cover rounded-full" src={logoUrl} />
          </div>
          <div class="text-left">
            <p class="font-brand font-bold text-xl text-ink leading-none">{businessName}</p>
            <p class="font-brand text-[9.5px] uppercase tracking-[0.24em] text-primary/90 mt-1 font-bold">
              Tienda de Regalos
            </p>
          </div>
        </div>

        <p
          id="footerDescEl"
          class={`text-xs text-slate-500 max-w-sm leading-relaxed font-light ${!showDescription ? 'hidden' : ''}`}
        >
          {footerDescription}
        </p>

        <p
          id="footerLocationEl"
          class={`text-xs text-primary font-medium ${!showLocationText ? 'hidden' : ''}`}
        >
          {locationText}
        </p>
      </div>

      <!-- Links: Colecciones -->
      <div
        id="footerCollectionsCol"
        class={`space-y-3 ${!showCollections ? 'hidden' : ''}`}
      >
        <h4 id="footerCollectionsTitle" class="text-xs font-bold uppercase tracking-wider text-ink">
          {collectionsTitle}
        </h4>
        <ul id="footerCollectionsList" class="space-y-2 text-xs">
          {collectionsLinks.map((item: any) => (
            <li>
              <a class="hover:text-primary transition-colors" href={item.url || '/catalogo'}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links: Servicio al Cliente -->
      <div
        id="footerCustomerServiceCol"
        class={`space-y-3 ${!showCustomerService ? 'hidden' : ''}`}
      >
        <h4 id="footerCustomerServiceTitle" class="text-xs font-bold uppercase tracking-wider text-ink">
          {customerServiceTitle}
        </h4>
        <ul id="footerCustomerServiceList" class="space-y-2 text-xs">
          {customerServiceLinks.map((item: any) => (
            <li>
              <a class="hover:text-primary transition-colors" href={item.url || '/#empaque-calidad'}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter & Club Ovejita -->
      <div
        id="footerClubCol"
        class={`space-y-3 ${!showClub ? 'hidden' : ''}`}
      >
        <h4 id="footerClubTitle" class="text-xs font-bold uppercase tracking-wider text-ink">
          {clubTitle}
        </h4>
        <p id="footerClubSub" class="text-xs text-slate-500">
          {clubSubtitle}
        </p>
        <form
          class="space-y-2"
          id="newsletterForm"
          onsubmit="event.preventDefault(); alert('¡Gracias por unirte al Club Ovejita! Te escribiremos con amor.');"
        >
          <input
            class="w-full text-xs px-3.5 py-2.5 bg-purple-50/50 border border-border rounded-xl focus:outline-none focus:ring-1 focus:ring-primary"
            placeholder="tu@correo.com"
            type="email"
            required
          />
          <button
            id="footerClubBtn"
            class="w-full py-2.5 bg-primary text-white text-xs font-bold rounded-xl hover:bg-primary-dark transition-colors shadow-xs cursor-pointer"
            type="submit"
          >
            {clubButtonText}
          </button>
        </form>
      </div>
    </div>

    <!-- Copyright & Legal -->
    <div
      id="footerBottomBar"
      class={`pt-8 border-t border-border flex flex-col sm:flex-row justify-between items-center text-[11px] text-slate-400 space-y-3 sm:space-y-0 ${!showBottomBar ? 'hidden' : ''}`}
    >
      <p id="footerCopyrightText">© 2025 {businessName}®. {copyrightText}</p>
      <div class="flex space-x-6">
        <a class="hover:underline" href={instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a class="hover:underline" href="/#empaque-calidad">Políticas de Envío</a>
        <a class="hover:underline" href="/#corporativo">Contacto</a>
      </div>
    </div>
  </div>

  <!-- Client-side Live Sync to display footer changes immediately on refresh -->
  <script is:inline>
    (async function syncFooterLive() {
      try {
        let liveSettings = null;
        try {
          const res = await fetch((window.PUBLIC_API_URL || '') + '/api/settings');
          if (res.ok) {
            const json = await res.json();
            liveSettings = json.data;
          }
        } catch (e) {}

        if (!liveSettings || !liveSettings.generalTexts) {
          try {
            const sbUrl = 'https://smxqqetxawatlnrttapw.supabase.co/rest/v1/BusinessSettings?select=*';
            const anon = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNteHFxZXR4YXdhdGxucnR0YXB3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1NzY2OTUsImV4cCI6MjEwNTE1MjY5NX0.ylCqYbxeswEWkuDZLdUGQzZNotxA5GCRaICeleyOxpQ';
            const sbRes = await fetch(sbUrl, {
              headers: { 'apikey': anon, 'Authorization': 'Bearer ' + anon }
            });
            if (sbRes.ok) {
              const arr = await sbRes.json();
              if (arr && arr[0]) {
                liveSettings = {
                  ...arr[0],
                  generalTexts: typeof arr[0].generalTexts === 'string' ? JSON.parse(arr[0].generalTexts) : arr[0].generalTexts
                };
              }
            }
          } catch (e) {}
        }

        const ft = liveSettings?.generalTexts?.footer;
        if (!ft) return;

        const footerEl = document.getElementById('mainFooterContainer');
        if (footerEl) {
          if (ft.hideFooter === true) {
            footerEl.classList.add('hidden');
            return;
          } else {
            footerEl.classList.remove('hidden');
          }
        }

        // Description
        const descEl = document.getElementById('footerDescEl');
        if (descEl) {
          if (ft.showDescription === false) {
            descEl.classList.add('hidden');
          } else {
            descEl.classList.remove('hidden');
            if (ft.description) descEl.textContent = ft.description;
          }
        }

        // Location
        const locEl = document.getElementById('footerLocationEl');
        if (locEl) {
          if (ft.showLocationText === false) {
            locEl.classList.add('hidden');
          } else {
            locEl.classList.remove('hidden');
            if (ft.locationText) locEl.textContent = ft.locationText;
          }
        }

        // Collections column
        const colSec = document.getElementById('footerCollectionsCol');
        if (colSec) {
          if (ft.showCollections === false) {
            colSec.classList.add('hidden');
          } else {
            colSec.classList.remove('hidden');
            const titleEl = document.getElementById('footerCollectionsTitle');
            if (titleEl && ft.collectionsTitle) titleEl.textContent = ft.collectionsTitle;
            if (Array.isArray(ft.collectionsLinks) && ft.collectionsLinks.length > 0) {
              const listEl = document.getElementById('footerCollectionsList');
              if (listEl) {
                listEl.innerHTML = ft.collectionsLinks.map(function(l) {
                  return '<li><a class="hover:text-primary transition-colors" href="' + (l.url || '/catalogo') + '">' + (l.label || '') + '</a></li>';
                }).join('');
              }
            }
          }
        }

        // Customer service column
        const csSec = document.getElementById('footerCustomerServiceCol');
        if (csSec) {
          if (ft.showCustomerService === false) {
            csSec.classList.add('hidden');
          } else {
            csSec.classList.remove('hidden');
            const titleEl = document.getElementById('footerCustomerServiceTitle');
            if (titleEl && ft.customerServiceTitle) titleEl.textContent = ft.customerServiceTitle;
            if (Array.isArray(ft.customerServiceLinks) && ft.customerServiceLinks.length > 0) {
              const listEl = document.getElementById('footerCustomerServiceList');
              if (listEl) {
                listEl.innerHTML = ft.customerServiceLinks.map(function(l) {
                  return '<li><a class="hover:text-primary transition-colors" href="' + (l.url || '/#empaque-calidad') + '">' + (l.label || '') + '</a></li>';
                }).join('');
              }
            }
          }
        }

        // Club column
        const clubSec = document.getElementById('footerClubCol');
        if (clubSec) {
          if (ft.showClub === false) {
            clubSec.classList.add('hidden');
          } else {
            clubSec.classList.remove('hidden');
            const titleEl = document.getElementById('footerClubTitle');
            if (titleEl && ft.clubTitle) titleEl.textContent = ft.clubTitle;
            const subEl = document.getElementById('footerClubSub');
            if (subEl && ft.clubSubtitle) subEl.textContent = ft.clubSubtitle;
            const btnEl = document.getElementById('footerClubBtn');
            if (btnEl && ft.clubButtonText) btnEl.textContent = ft.clubButtonText;
          }
        }

        // Bottom bar
        const bottomEl = document.getElementById('footerBottomBar');
        if (bottomEl) {
          if (ft.showBottomBar === false) {
            bottomEl.classList.add('hidden');
          } else {
            bottomEl.classList.remove('hidden');
            const copyEl = document.getElementById('footerCopyrightText');
            if (copyEl && ft.copyrightText) {
              copyEl.textContent = '© 2025 ' + (liveSettings.businessName || 'Ovejita Sorpresas') + '®. ' + ft.copyrightText;
            }
          }
        }
      } catch (err) {
        console.warn('[Footer] Live sync failed:', err);
      }
    })();
  </script>
</footer>

