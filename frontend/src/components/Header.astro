---
import { getProducts, getCategories } from '../lib/api';

interface Props {
  settings?: any;
}

const { settings = {} } = Astro.props;
const logoUrl = settings?.logoUrl || '/images/LOGO.jpg';
const businessName = settings?.businessName || 'Ovejita Sorpresas';
const rawWa = settings?.whatsappNumber || '992750599';
let whatsappNumber = String(rawWa).replace(/\D/g, '');
if (whatsappNumber.length === 9 && whatsappNumber.startsWith('9')) {
  whatsappNumber = '51' + whatsappNumber;
}

const [products, categories] = await Promise.all([
  getProducts(),
  getCategories(),
]);

const searchData = (products || []).map((p: any) => ({
  id: p.id,
  name: p.name,
  slug: p.slug,
  price: Number(p.finalPrice || p.price || 0).toFixed(2),
  category: p.category?.name || 'Colección Especial',
  imageUrl: p.primaryImage?.url || p.images?.[0]?.url || '/images/LOGO.jpg',
  description: `${p.shortDescription || ''} ${p.description || ''}`,
}));
---

<header
  class="sticky top-0 z-40 bg-[#FFFDFE]/95 backdrop-blur-md border-b border-border/80 px-4 sm:px-6 lg:px-8 py-2 sm:py-3 transition-all shadow-xs"
  data-purpose="brand-header"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Left: Mobile Menu / Desktop Search & Notice -->
    <div class="flex items-center gap-2 sm:gap-3 w-1/3">
      <!-- Mobile menu trigger with 2 horizontal lines -->
      <button
        aria-label="Desplegar catálogos disponibles"
        class="lg:hidden p-2 text-plum hover:text-primary transition-colors flex items-center gap-1.5 focus:outline-none rounded-full hover:bg-primary-soft/80 cursor-pointer"
        id="menuToggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobileCatalogsDrawer"
      >
        <svg class="w-5 h-5 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M3.75 8.25h16.5M3.75 15.75h16.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="text-[11px] tracking-wider uppercase font-bold text-plum font-brand hidden xs:inline">
          Catálogos
        </span>
      </button>

      <!-- Mobile search button toggle -->
      <button
        id="mobileSearchToggle"
        type="button"
        class="lg:hidden p-2 text-plum hover:text-primary transition-colors rounded-full hover:bg-primary-soft/80"
        aria-label="Buscar productos"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
      </button>

      <!-- Desktop search container with Live Autocomplete Dropdown -->
      <div class="hidden lg:flex items-center space-x-3 relative">
        <div class="relative w-64 xl:w-72" data-purpose="search-container" id="searchContainer">
          <input
            id="searchInput"
            class="w-full text-xs font-brand font-medium pl-9 pr-7 py-2 bg-purple-50/60 border border-purple-100 rounded-full focus:ring-2 focus:ring-primary/40 focus:border-primary focus:bg-white focus:outline-none transition-all placeholder:text-purple-300 text-ink"
            placeholder="Buscar versículo, libreta..."
            type="search"
            autocomplete="off"
          />
          <svg
            class="w-4 h-4 absolute left-3 top-2.5 text-primary/60 pointer-events-none"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            ></path>
          </svg>
          <button
            id="clearSearchBtn"
            type="button"
            class="hidden absolute right-2.5 top-2.5 text-slate-400 hover:text-slate-600 p-0.5 rounded-full"
            aria-label="Limpiar búsqueda"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

          <!-- Floating Live Results Dropdown -->
          <div
            id="searchResultsDropdown"
            class="hidden absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-2xl border border-purple-100/90 overflow-hidden z-50 transition-all duration-200"
          >
            <div id="searchResultsList" class="max-h-80 overflow-y-auto p-1.5 space-y-1 divide-y divide-purple-50/60">
              <!-- Rendered dynamically -->
            </div>
            <div id="searchDropdownFooter" class="p-2.5 bg-purple-50/50 border-t border-purple-100/70 text-center">
              <button
                type="button"
                id="searchSeeAllBtn"
                class="text-[11px] text-primary font-bold hover:text-primary-dark transition-colors inline-flex items-center gap-1 cursor-pointer"
              >
                <span>Ver todos en el catálogo</span>
                <span>→</span>
              </button>
            </div>
          </div>
        </div>
        <span class="text-xs text-purple-400 font-brand font-medium italic hidden xl:inline">
          Envíos a todo el país
        </span>
      </div>
    </div>

    <!-- Center: Official Brand Logo with Faithful Typography -->
    <div class="flex-shrink-0 flex items-center justify-center">
      <a aria-label="Ovejita Sorpresas Inicio" class="group flex items-center space-x-2.5 sm:space-x-3 text-center focus:outline-none" href="/">
        <div class="h-10 w-10 sm:h-12 sm:w-12 overflow-hidden flex items-center justify-center rounded-full bg-[#c5b5e3]/20 p-0.5 ring-1 ring-border shadow-xs group-hover:scale-105 transition-transform duration-300">
          <img
            alt={businessName}
            class="h-full w-full object-cover rounded-full"
            src={logoUrl}
          />
        </div>
        <div class="flex flex-col text-left justify-center">
          <span class="font-brand font-bold text-base sm:text-xl leading-none text-ink group-hover:text-primary transition-colors tracking-tight">
            {businessName}
          </span>
          <span class="font-brand text-[8.5px] sm:text-[9.5px] uppercase tracking-[0.24em] font-bold text-primary/90 mt-1 sm:mt-1.5 leading-none">
            Tienda de Regalos
          </span>
        </div>
      </a>
    </div>

    <!-- Right: Desktop Navigation & Cart Bag -->
    <div class="flex items-center justify-end space-x-6 w-1/3">
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center space-x-6 text-sm font-brand font-semibold">
        <!-- Desktop Catalogs Dropdown -->
        <div class="relative group" id="desktopCatalogsDropdown">
          <a
            href="/catalogo"
            class="text-ink hover:text-primary transition-colors inline-flex items-center gap-1.5 py-2 cursor-pointer"
            aria-haspopup="true"
          >
            <span>Catálogos</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-primary group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>

          <!-- Dropdown menu -->
          <div class="absolute left-0 top-full pt-1.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 min-w-[280px]">
            <div class="bg-white rounded-2xl shadow-xl border border-purple-100 p-2 space-y-1">
              <div class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400">
                Selecciona tu Catálogo
              </div>
              {categories.map((cat) => {
                const count = (products || []).filter(
                  (p: any) => p.categoryId === cat.id || p.category?.slug === cat.slug
                ).length;
                const isDigital = cat.slug === 'disenos-digitales';
                return (
                  <a
                    href={`/catalogo/${cat.slug}`}
                    class="flex items-center justify-between p-2.5 rounded-xl hover:bg-purple-50/70 transition-colors group/item"
                  >
                    <div class="flex items-center gap-2.5">
                      <div class={`w-7 h-7 rounded-lg flex items-center justify-center shrink-0 ${isDigital ? 'bg-emerald-50 text-emerald-600' : 'bg-purple-50 text-primary'} group-hover/item:scale-105 transition-transform`}>
                        {isDigital ? (
                          <svg class="w-3.5 h-3.5 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                          </svg>
                        ) : (
                          <svg class="w-3.5 h-3.5 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                          </svg>
                        )}
                      </div>
                      <span class="text-xs font-bold text-ink group-hover/item:text-primary transition-colors">
                        {cat.name}
                      </span>
                    </div>
                    <span class="text-[10px] font-semibold text-slate-400 bg-purple-50 px-2 py-0.5 rounded-full">
                      {count}
                    </span>
                  </a>
                );
              })}
              <div class="pt-1.5 mt-1 border-t border-purple-100/70">
                <a
                  href="/catalogo"
                  class="flex items-center justify-between p-2 text-xs font-bold text-primary hover:text-primary-dark rounded-xl hover:bg-primary-soft/40 transition-colors"
                >
                  <span>Ver todos los catálogos</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <a class="text-ink hover:text-primary transition-colors" href="/#empaque-calidad">Empaque & Calidad</a>
        <a class="text-ink hover:text-primary transition-colors" href="/#comunidad">Comunidad</a>
      </nav>

      <!-- Cart Bag Trigger (Hidden in Canva Link Mode) -->
      {(!settings?.generalTexts?.isCanvaCatalogsMode) && (
        <button
          aria-label="Ver bolsa de sorpresas"
          class="relative p-2 text-plum hover:text-primary transition-colors focus:outline-none rounded-full hover:bg-primary-soft/80 cursor-pointer"
          id="bagTrigger"
          type="button"
        >
          <svg class="w-6 h-6 stroke-[1.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          <span
            class="absolute top-0.5 right-0.5 bg-secondary text-[10px] text-white font-bold w-4 h-4 rounded-full flex items-center justify-center shadow-xs transition-transform"
            id="bagCounter"
          >
            0
          </span>
        </button>
      )}
    </div>
  </div>

  <!-- Mobile Search Bar Expandable Drawer -->
  <div id="mobileSearchDrawer" class="hidden lg:hidden pt-2.5 pb-1 border-t border-purple-100/60 mt-2">
    <div class="relative">
      <input
        id="mobileSearchInput"
        class="w-full text-xs font-brand font-medium pl-9 pr-3 py-2 bg-purple-50/60 border border-purple-100 rounded-full focus:ring-2 focus:ring-primary/40 focus:border-primary focus:bg-white focus:outline-none"
        placeholder="Buscar versículo, libreta..."
        type="search"
        autocomplete="off"
      />
      <svg
        class="w-4 h-4 absolute left-3 top-2.5 text-primary/60 pointer-events-none"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
      </svg>
    </div>
    <!-- Mobile results -->
    <div id="mobileSearchResults" class="hidden mt-2 bg-white rounded-2xl shadow-lg border border-purple-100 p-2 max-h-60 overflow-y-auto space-y-1"></div>
  </div>

  <!-- Mobile Catalogs Slide-over Drawer & Overlay ("Dos Rayas") -->
  <div
    id="mobileDrawerBackdrop"
    class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 hidden opacity-0 transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  <aside
    id="mobileCatalogsDrawer"
    class="fixed top-0 left-0 bottom-0 w-[85%] max-w-sm bg-white z-50 shadow-2xl flex flex-col transform -translate-x-full transition-transform duration-300 ease-out overflow-hidden"
    aria-label="Catálogos Disponibles"
    aria-hidden="true"
  >
    <!-- Drawer Header -->
    <div class="p-4 sm:p-5 border-b border-border/80 flex items-center justify-between bg-purple-50/40">
      <div class="flex items-center gap-2.5">
        <div class="h-9 w-9 overflow-hidden rounded-full bg-[#c5b5e3]/20 ring-1 ring-border p-0.5 shrink-0">
          <img alt={businessName} class="h-full w-full object-cover rounded-full" src={logoUrl} />
        </div>
        <div>
          <span class="font-brand font-bold text-sm text-ink block leading-tight">{businessName}</span>
          <span class="text-[9px] uppercase tracking-wider font-bold text-primary font-brand">Elige tu Catálogo</span>
        </div>
      </div>
      <button
        id="closeMobileDrawerBtn"
        type="button"
        class="p-2 text-slate-400 hover:text-ink hover:bg-white rounded-full transition-colors cursor-pointer"
        aria-label="Cerrar menú de catálogos"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Drawer Content Scrollable -->
    <div class="flex-1 overflow-y-auto p-4 space-y-5">
      <!-- Section: Catalogs -->
      <div>
        <div class="flex items-center justify-between mb-3 px-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-brand">
            Catálogos Disponibles
          </span>
          <span class="text-[10px] bg-primary/10 text-primary font-bold px-2 py-0.5 rounded-full">
            {categories.length} colecciones
          </span>
        </div>

        <div class="space-y-2">
          {categories.map((cat, idx) => {
            const catProducts = (products || []).filter(
              (p: any) => p.categoryId === cat.id || p.category?.slug === cat.slug
            );
            const count = catProducts.length;
            const coverImg = catProducts[0]?.primaryImage?.url || catProducts[0]?.images?.[0]?.url || `/images/libreta${(idx % 3) + 1}.png`;
            const isDigital = cat.slug === 'disenos-digitales';

            return (
              <a
                href={`/catalogo/${cat.slug}`}
                class="mobile-cat-link flex items-center gap-3 p-2.5 rounded-2xl bg-[#FAF8FB] hover:bg-primary-soft/60 border border-border/70 hover:border-primary/40 transition-all active:scale-[0.98] group"
              >
                <div class="w-12 h-12 rounded-xl overflow-hidden bg-purple-100 shrink-0 border border-border/50 relative">
                  <img src={coverImg} alt={cat.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                  <span class="absolute top-1 left-1 w-5 h-5 rounded-md bg-white/90 backdrop-blur-xs flex items-center justify-center shadow-2xs">
                    {isDigital ? (
                      <svg class="w-3 h-3 text-emerald-600 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                      </svg>
                    ) : (
                      <svg class="w-3 h-3 text-primary stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                      </svg>
                    )}
                  </span>
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="text-xs font-bold text-ink group-hover:text-primary transition-colors truncate">
                    {cat.name}
                  </h4>
                  <p class="text-[10px] text-slate-400 font-light truncate mt-0.5">
                    {count > 0 ? `${count} ${count === 1 ? 'modelo' : 'modelos'} disponibles` : 'Nueva colección'}
                  </p>
                </div>
                <div class="w-7 h-7 rounded-full bg-white flex items-center justify-center text-primary text-xs shadow-2xs group-hover:translate-x-0.5 transition-transform">
                  <svg class="w-3.5 h-3.5 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                  </svg>
                </div>
              </a>
            );
          })}
        </div>

        <!-- Hub link -->
        <a
          href="/catalogo"
          class="mobile-cat-link mt-3 w-full py-2.5 px-4 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-xl text-center flex items-center justify-center gap-2 shadow-soft hover:bg-primary-dark transition-all"
        >
          <span>Ver Selector de Catálogos</span>
          <span>→</span>
        </a>
      </div>

      <!-- Section: Navigation Links -->
      <div class="pt-4 border-t border-border/70 space-y-1">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-brand block mb-2 px-1">
          Navegación
        </span>
        <a
          href="/"
          class="mobile-cat-link flex items-center gap-2.5 px-3 py-2 text-xs font-bold text-ink hover:text-primary hover:bg-purple-50/50 rounded-xl transition-colors"
        >
          <span>🏠</span>
          <span>Inicio</span>
        </a>
        <a
          href="/#empaque-calidad"
          class="mobile-cat-link flex items-center gap-2.5 px-3 py-2 text-xs font-bold text-ink hover:text-primary hover:bg-purple-50/50 rounded-xl transition-colors"
        >
          <span>✨</span>
          <span>Empaque & Calidad</span>
        </a>
        <a
          href="/#comunidad"
          class="mobile-cat-link flex items-center gap-2.5 px-3 py-2 text-xs font-bold text-ink hover:text-primary hover:bg-purple-50/50 rounded-xl transition-colors"
        >
          <span>📸</span>
          <span>Comunidad</span>
        </a>
      </div>
    </div>

    <!-- Drawer Footer (WhatsApp) -->
    <div class="p-4 border-t border-border/80 bg-gradient-to-r from-purple-50/50 to-pink-50/40">
      <a
        href={`https://wa.me/${whatsappNumber}?text=Hola%20Ovejita%20Sorpresas%20🌸,%20deseo%20consultar%20sobre%20los%20catálogos.`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl flex items-center justify-center gap-2 shadow-xs transition-colors"
      >
        <span>💬</span>
        <span>Chatear por WhatsApp</span>
      </a>
    </div>
  </aside>

  <!-- Embedded Product Search Catalog Data -->
  <script id="headerSearchData" type="application/json" set:html={JSON.stringify(searchData)} />

  <!-- Interactive Client-side Live Search Script -->
  <script is:inline>
    (function () {
      function initSearch() {
        const dataEl = document.getElementById('headerSearchData');
        let products = [];
        try {
          if (dataEl) products = JSON.parse(dataEl.textContent || '[]');
        } catch (e) {
          products = [];
        }

        const desktopInput = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const dropdown = document.getElementById('searchResultsDropdown');
        const resultsList = document.getElementById('searchResultsList');
        const seeAllBtn = document.getElementById('searchSeeAllBtn');
        const searchContainer = document.getElementById('searchContainer');

        const mobileToggle = document.getElementById('mobileSearchToggle');
        const mobileDrawer = document.getElementById('mobileSearchDrawer');
        const mobileInput = document.getElementById('mobileSearchInput');
        const mobileResults = document.getElementById('mobileSearchResults');

        // Mobile toggle drawer
        mobileToggle?.addEventListener('click', () => {
          mobileDrawer?.classList.toggle('hidden');
          if (!mobileDrawer?.classList.contains('hidden')) {
            mobileInput?.focus();
          }
        });

        function performSearch(query, targetList, targetDropdown) {
          const q = query.toLowerCase().trim();
          if (!q) {
            targetDropdown?.classList.add('hidden');
            clearBtn?.classList.add('hidden');
            return;
          }

          clearBtn?.classList.remove('hidden');

          const matches = products.filter((p) => {
            return (
              p.name.toLowerCase().includes(q) ||
              p.category.toLowerCase().includes(q) ||
              p.description.toLowerCase().includes(q)
            );
          });

          if (!targetList || !targetDropdown) return;

          targetDropdown.classList.remove('hidden');

          if (matches.length === 0) {
            targetList.innerHTML = `
              <div class="p-4 text-center text-xs text-slate-500">
                <span class="text-base block mb-1">🌸</span>
                No encontramos productos con "<strong>${q}</strong>".
                <p class="text-[10.5px] text-slate-400 mt-1 font-brand">Prueba buscando "cuaderno", "salmo", "serenidad" o "agenda".</p>
              </div>
            `;
            return;
          }

          targetList.innerHTML = matches
            .map(
              (p) => `
            <a href="/producto/${p.slug}" class="flex items-center gap-3 p-2 rounded-xl hover:bg-purple-50/80 transition-colors group">
              <img src="${p.imageUrl}" alt="${p.name}" class="w-10 h-10 rounded-lg object-cover border border-purple-100 shrink-0 shadow-2xs" />
              <div class="min-w-0 flex-1 text-left">
                <span class="text-xs font-brand font-bold text-ink block truncate group-hover:text-primary transition-colors">${p.name}</span>
                <div class="flex items-center gap-2 text-[10.5px] text-slate-400">
                  <span class="text-slate-500 font-medium">${p.category}</span>
                  <span class="text-emerald-600 font-bold font-brand">S/ ${p.price}</span>
                </div>
              </div>
              <span class="text-xs text-primary font-bold opacity-0 group-hover:opacity-100 transition-opacity pr-1">→</span>
            </a>
          `
            )
            .join('');

          // Also trigger real-time filtering on homepage productsGrid if present
          const productCards = document.querySelectorAll('.product-item');
          if (productCards.length > 0) {
            productCards.forEach((card) => {
              const name = (card.getAttribute('data-name') || '').toLowerCase();
              if (name.includes(q) || q === '') {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          }
        }

        // Desktop Input
        desktopInput?.addEventListener('input', (e) => {
          performSearch(e.target.value, resultsList, dropdown);
        });

        desktopInput?.addEventListener('focus', () => {
          if (desktopInput.value.trim()) {
            dropdown?.classList.remove('hidden');
          }
        });

        desktopInput?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            dropdown?.classList.add('hidden');
            const cat = document.getElementById('catalogo');
            if (cat) {
              cat.scrollIntoView({ behavior: 'smooth' });
            } else {
              window.location.href = '/#catalogo';
            }
          } else if (e.key === 'Escape') {
            dropdown?.classList.add('hidden');
          }
        });

        clearBtn?.addEventListener('click', () => {
          if (desktopInput) {
            desktopInput.value = '';
            desktopInput.focus();
            dropdown?.classList.add('hidden');
            clearBtn.classList.add('hidden');
            // reset homepage grid
            document.querySelectorAll('.product-item').forEach((card) => {
              card.style.display = 'flex';
            });
          }
        });

        seeAllBtn?.addEventListener('click', () => {
          dropdown?.classList.add('hidden');
          const q = desktopInput?.value?.trim() || '';
          window.location.href = q ? `/catalogo?q=${encodeURIComponent(q)}` : '/catalogo';
        });

        // Mobile Input
        mobileInput?.addEventListener('input', (e) => {
          performSearch(e.target.value, mobileResults, mobileResults);
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
          if (searchContainer && !searchContainer.contains(e.target)) {
            dropdown?.classList.add('hidden');
          }
        });

        // Smooth scroll for nav links on homepage
        document.querySelectorAll('nav a[href^="/#"]').forEach((link) => {
          link.addEventListener('click', (e) => {
            if (window.location.pathname === '/' || window.location.pathname === '') {
              const hash = link.getAttribute('href')?.replace('/#', '');
              if (hash) {
                const target = document.getElementById(hash);
                if (target) {
                  e.preventDefault();
                  target.scrollIntoView({ behavior: 'smooth' });
                  history.pushState(null, '', '#' + hash);
                }
              }
            }
          });
        });

        // Mobile Catalogs Drawer ("Dos Rayas") logic
        const menuToggle = document.getElementById('menuToggle');
        const drawer = document.getElementById('mobileCatalogsDrawer');
        const backdrop = document.getElementById('mobileDrawerBackdrop');
        const closeDrawerBtn = document.getElementById('closeMobileDrawerBtn');
        const mobileCatLinks = document.querySelectorAll('.mobile-cat-link');

        function openDrawer() {
          if (!drawer || !backdrop) return;
          backdrop.classList.remove('hidden');
          requestAnimationFrame(() => {
            backdrop.classList.remove('opacity-0');
            backdrop.classList.add('opacity-100');
            drawer.classList.remove('-translate-x-full');
          });
          document.body.style.overflow = 'hidden';
          menuToggle?.setAttribute('aria-expanded', 'true');
        }

        function closeDrawer() {
          if (!drawer || !backdrop) return;
          backdrop.classList.remove('opacity-100');
          backdrop.classList.add('opacity-0');
          drawer.classList.add('-translate-x-full');
          setTimeout(() => {
            backdrop.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
          menuToggle?.setAttribute('aria-expanded', 'false');
        }

        menuToggle?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openDrawer();
        });

        closeDrawerBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          closeDrawer();
        });

        backdrop?.addEventListener('click', closeDrawer);

        mobileCatLinks.forEach((link) => {
          link.addEventListener('click', () => {
            closeDrawer();
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !drawer?.classList.contains('-translate-x-full')) {
            closeDrawer();
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSearch);
      } else {
        initSearch();
      }
    })();
  </script>
</header>

