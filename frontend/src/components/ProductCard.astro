---
interface Props {
  product: any;
  whatsappNumber?: string;
}

const { product, whatsappNumber = "986951425" } = Astro.props;

// Gather all available product images in order
const rawImages = product.images && product.images.length > 0
  ? product.images
  : [{ url: product.primaryImage?.url || "/images/LOGO.jpg", altText: product.name }];

const images = rawImages.map((img: any) => ({
  url: img.url || "/images/LOGO.jpg",
  altText: img.altText || product.name,
}));

const hasMultipleImages = images.length > 1;
const primaryImage = images[0]?.url || "/images/LOGO.jpg";
const categorySlug = product.category?.slug || "general";
const formattedPrice = Number(product.finalPrice || product.price).toFixed(2);
const formattedPrevPrice = product.previousPrice ? Number(product.previousPrice).toFixed(2) : null;

const waMessage = encodeURIComponent(
  `Hola Ovejita Sorpresas 🌸, deseo información sobre este producto: "${product.name}" (S/ ${formattedPrice})`
);
const waLink = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
const cardId = `pcard-${product.id || Math.random().toString(36).substring(2, 8)}`;
const isDigital = product.productType === 'DIGITAL' || product.category?.slug === 'disenos-digitales';
---

<article
  class="product-item group flex flex-col justify-between bg-white rounded-3xl p-5 border border-border shadow-soft card-hover-tactile transition-all duration-300 hover:shadow-floating"
  data-id={product.id}
  data-category={categorySlug}
  data-name={product.name.toLowerCase()}
  data-price={product.finalPrice || product.price || 0}
  data-featured={product.featured ? "true" : "false"}
  data-purpose="product-card"
>
  <div>
    <!-- Interactive Image Carousel Frame -->
    <div
      class="relative overflow-hidden rounded-2xl aspect-[4/4.8] sm:aspect-[4/5] bg-primary-soft/30 mb-4 group/carousel select-none"
      id={cardId}
      data-has-multiple={hasMultipleImages ? "true" : "false"}
      data-total-slides={images.length}
    >
      <!-- Slides track with smooth CSS slide transition -->
      <div
        class="carousel-track flex w-full h-full transition-transform duration-500 ease-out"
        style="transform: translateX(0%);"
      >
        {images.map((img: any, idx: number) => (
          <a
            href={`/producto/${product.slug}`}
            class="w-full h-full flex-shrink-0 block relative"
            title={`Ver detalle de ${product.name}`}
          >
            <img
              alt={img.altText || product.name}
              class="w-full h-full object-cover object-center group-hover/carousel:scale-105 transition-transform duration-700 ease-out"
              src={img.url}
              loading={idx === 0 ? "eager" : "lazy"}
            />
          </a>
        ))}
      </div>

      <!-- Badges: Featured & New -->
      <div class="absolute top-3 left-3 flex flex-col gap-1.5 z-10 pointer-events-none">
        {product.featured && (
          <span class="inline-flex items-center gap-1 bg-white/95 backdrop-blur-sm border border-secondary/30 text-primary text-[10px] font-brand font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-xs">
            <svg class="w-3 h-3 text-secondary fill-secondary" viewBox="0 0 24 24">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
            <span>Destacado</span>
          </span>
        )}
        {product.isNew && (
          <span class="bg-pink-100/90 text-secondary border border-secondary/20 text-[10px] font-brand font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-xs">
            Nuevo
          </span>
        )}
        {isDigital && (
          <span class="inline-flex items-center gap-1 bg-emerald-600 text-white text-[10px] font-brand font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-xs">
            <svg class="w-3 h-3 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            <span>Descarga PDF</span>
          </span>
        )}
      </div>

      {product.discountPercentage && (
        <span class="absolute top-3 right-3 bg-secondary text-white text-[10px] font-brand font-bold px-2.5 py-1 rounded-full shadow-xs z-10 pointer-events-none">
          -{product.discountPercentage}%
        </span>
      )}

      <!-- Multi-image dynamic navigation controls -->
      {hasMultipleImages && (
        <>
          <!-- Previous Arrow -->
          <button
            type="button"
            class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-plum shadow-md backdrop-blur-sm flex items-center justify-center opacity-0 group-hover/carousel:opacity-100 transition-all hover:scale-110 active:scale-95 z-20 cursor-pointer"
            aria-label="Imagen anterior"
          >
            <svg class="w-4 h-4 text-plum" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Next Arrow -->
          <button
            type="button"
            class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-plum shadow-md backdrop-blur-sm flex items-center justify-center opacity-0 group-hover/carousel:opacity-100 transition-all hover:scale-110 active:scale-95 z-20 cursor-pointer"
            aria-label="Siguiente imagen"
          >
            <svg class="w-4 h-4 text-plum" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Dot Indicators -->
          <div class="carousel-dots absolute bottom-3 left-0 right-0 flex justify-center items-center gap-1.5 z-20 pointer-events-auto">
            {images.map((_: any, idx: number) => (
              <button
                type="button"
                data-slide-index={idx}
                class={`carousel-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer ${
                  idx === 0 ? "w-5 bg-white shadow-xs" : "w-1.5 bg-white/60 hover:bg-white/90"
                }`}
                aria-label={`Ver foto ${idx + 1}`}
              />
            ))}
          </div>

          <!-- Counter indicator -->
          <div class="absolute bottom-3 right-3 bg-black/50 backdrop-blur-sm text-white text-[9px] font-bold px-2 py-0.5 rounded-md opacity-0 group-hover/carousel:opacity-100 transition-opacity pointer-events-none z-10">
            <span class="current-indicator">1</span>/{images.length}
          </div>
        </>
      )}
    </div>

    <!-- Product Details -->
    <div class="space-y-2">
      <div class="flex justify-between items-start">
        <div>
          <a
            href={`/catalogo/${categorySlug}`}
            class="text-[10.5px] uppercase font-bold tracking-wider text-primary hover:underline block font-brand"
            title={`Ver catálogo de ${product.category?.name || "esta categoría"}`}
          >
            {product.category?.name || "Colección Especial"}
          </a>
          <h3 class="font-serif font-bold text-lg text-ink leading-snug">
            <a href={`/producto/${product.slug}`} class="hover:text-primary transition-colors">
              {product.name}
            </a>
          </h3>
        </div>
        <div class="text-right pl-2">
          <span class="text-base font-bold text-ink whitespace-nowrap block font-brand">
            S/ {formattedPrice}
          </span>
          {formattedPrevPrice && (
            <span class="text-[11px] text-slate-400 line-through block font-brand">
              S/ {formattedPrevPrice}
            </span>
          )}
        </div>
      </div>

      <p class="text-xs text-plum/80 leading-relaxed line-clamp-3 font-light">
        {product.shortDescription || product.description}
      </p>

      {/* Interactive Accordion for specs */}
      {isDigital ? (
        <details class="group/spec text-[12px] bg-emerald-50/60 rounded-xl p-3 border border-emerald-200 cursor-pointer transition-all mt-2">
          <summary class="flex justify-between items-center list-none font-brand font-bold text-emerald-800 select-none">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-600 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              <span>Formato & Descarga</span>
            </span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open/spec:rotate-180 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-2.5 pt-2 border-t border-emerald-200/80 space-y-1.5 text-emerald-900 text-[11.5px]">
            <p class="flex items-center gap-1.5">• <span>Archivo PDF en alta resolución (300 DPI).</span></p>
            <p class="flex items-center gap-1.5">• <span>Listo para imprimir en tamaño A4 o A5.</span></p>
            <div class="flex items-center gap-1.5 text-[11px] text-emerald-700 font-semibold pt-1">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span><strong>Entrega digital:</strong> Enlace de descarga inmediato tras tu pago.</span>
            </div>
          </div>
        </details>
      ) : (
        <details class="group/spec text-[12px] bg-primary-soft/50 rounded-xl p-3 border border-border cursor-pointer transition-all mt-2">
          <summary class="flex justify-between items-center list-none font-brand font-bold text-plum select-none">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-primary stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H4.5a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
              </svg>
              <span>¿Qué incluye?</span>
            </span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open/spec:rotate-180 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-2.5 pt-2 border-t border-border/80 space-y-1.5 text-slate-600 text-[11.5px]">
            <p class="flex items-center gap-1.5">• <span>Wire-o dorado reforzado apertura 360°.</span></p>
            <p class="flex items-center gap-1.5">• <span>Hojas de 90 gr/m² resistentes a tinta y resaltador.</span></p>
            <div class="flex items-center gap-1.5 text-[11px] text-primary font-semibold pt-1">
              <svg class="w-3.5 h-3.5 text-secondary shrink-0 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
              <span><strong>Empaque de obsequio:</strong> Caja aromática con lazo y dedicatoria personalizada.</span>
            </div>
          </div>
        </details>
      )}
    </div>
  </div>

  <!-- Action CTAs -->
  <div class="mt-5 pt-3 border-t border-border/80 space-y-2">
    <div class="flex gap-2">
      {isDigital ? (
        <button
          class="open-digital-checkout-btn flex-1 py-3 bg-emerald-600 text-white text-xs font-bold uppercase tracking-wider rounded-xl hover:bg-emerald-700 hover:scale-[1.02] active:scale-95 transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
          data-product-id={product.id}
          data-product-name={product.name}
          data-product-price={product.finalPrice || product.price}
          data-product-img={primaryImage}
          data-product-file={product.digitalFileUrl || '/uploads/pdfs/test-diseno.pdf'}
          data-product-filename={product.digitalFileName || 'diseno-imprimible.pdf'}
          type="button"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Comprar PDF</span>
        </button>
      ) : (
        <button
          class="add-to-bag-btn flex-1 py-3 bg-primary text-white text-xs font-semibold rounded-xl hover:bg-primary-dark hover:scale-[1.02] active:scale-95 transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
          data-product-id={product.id}
          data-product-name={product.name}
          data-product-price={product.finalPrice || product.price}
          data-product-img={primaryImage}
          type="button"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M12 4.5v15m7.5-7.5h-15" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
          <span>Añadir a mi pedido</span>
        </button>
      )}

      <a
        class="px-3.5 py-3 border border-emerald-300 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded-xl flex items-center justify-center transition-colors shadow-xs cursor-pointer"
        href={waLink}
        rel="noopener noreferrer"
        target="_blank"
        title="Deseo información sobre este producto por WhatsApp"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
        </svg>
      </a>
    </div>

    <a
      href={`/producto/${product.slug}`}
      class="w-full py-2 text-center text-primary text-xs font-semibold rounded-xl hover:bg-primary-soft/60 transition-colors block"
    >
      Ver detalles del producto →
    </a>
  </div>
</article>
