---
interface Props {
  banner?: any;
}

const { banner } = Astro.props;
if (!banner) return null;
---

<section class="py-10 bg-gradient-to-r from-[#FAF8FB] via-purple-50/50 to-[#FFFDFE] border-t border-border/70" id="banner-promocional">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-r from-primary-soft/40 via-white to-pink-50/40 border border-primary/20 p-8 sm:p-10 shadow-soft flex flex-col md:flex-row items-center justify-between gap-8">
      {banner.imageUrl && (
        <div class="w-full md:w-72 h-48 rounded-2xl overflow-hidden shadow-card shrink-0 border border-border/80">
          <img
            src={banner.imageUrl}
            alt={banner.title || "Banner Promocional"}
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
      )}

      <div class="space-y-3 text-center md:text-left flex-1">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink-100 text-secondary text-[11px] font-bold uppercase tracking-wider">
          <span>✨ Edición & Promoción Exclusiva</span>
        </span>

        <h3 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-ink leading-tight">
          {banner.title}
        </h3>

        {banner.subtitle && (
          <p class="text-xs sm:text-sm lg:text-base text-slate-600 font-light leading-relaxed max-w-xl">
            {banner.subtitle}
          </p>
        )}
      </div>

      {banner.linkUrl && (
        <div class="shrink-0">
          <a
            href={banner.linkUrl}
            class="inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary-dark text-white text-xs font-bold uppercase tracking-wider rounded-full shadow-soft hover:scale-105 active:scale-95 transition-all"
          >
            {banner.linkText || "Ver Detalles →"}
          </a>
        </div>
      )}
    </div>
  </div>
</section>
