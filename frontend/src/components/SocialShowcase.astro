---
interface Props {
  settings?: any;
}

const { settings = {} } = Astro.props;

const social = settings?.generalTexts?.socialShowcase || {};
const isEnabled = social.enabled !== false;

const tag = social.tag || '✨ NUESTRA COMUNIDAD EN VIVO';
const title = social.title || 'Publicaciones Reales en Instagram & TikTok';
const subtitle = social.subtitle ||
  'Conéctate con nuestro día a día: mira nuestros detrás de cámaras, empaques perfumados, dedicatorias y novedades recién salidas del taller.';

const instagramUrl = social.instagramUrl || 'https://www.instagram.com/ovejitasorpresas_/';
const instagramHandle = social.instagramHandle || '@ovejitasorpresas_';

const tiktokUrl = social.tiktokUrl || 'https://www.tiktok.com/@ovejitasorpresas';
const tiktokHandle = social.tiktokHandle || '@ovejitasorpresas';

// Extract Instagram embed URL
function getInstagramEmbedUrl(url: string): string {
  if (!url) return '';
  const match = url.match(/\/(p|reel)\/([A-Za-z0-9_-]+)/);
  if (match) {
    return `https://www.instagram.com/${match[1]}/${match[2]}/embed/captioned/`;
  }
  return '';
}

// Extract TikTok unique ID or video ID
function getTikTokData(url: string) {
  if (!url) return { type: 'creator', uniqueId: 'ovejitasorpresas', url: tiktokUrl };
  const videoMatch = url.match(/\/video\/(\d+)/);
  if (videoMatch) {
    return { type: 'video', videoId: videoMatch[1], url };
  }
  const creatorMatch = url.match(/@([A-Za-z0-9_.-]+)/);
  if (creatorMatch) {
    return { type: 'creator', uniqueId: creatorMatch[1], url: `https://www.tiktok.com/@${creatorMatch[1]}` };
  }
  return { type: 'creator', uniqueId: 'ovejitasorpresas', url: tiktokUrl };
}

const rawIgPost = social.instagramPostUrl || 'https://www.instagram.com/p/DdIXOkLDUIK/';
const instagramEmbedUrl = getInstagramEmbedUrl(rawIgPost) || 'https://www.instagram.com/p/DdIXOkLDUIK/embed/captioned/';

const rawTiktok = social.tiktokEmbedUrl || tiktokUrl;
const tiktokData = getTikTokData(rawTiktok);

const cards = social.cards && social.cards.length > 0 ? social.cards : [
  {
    title: 'Tomatodo Personalizado Pink',
    desc: 'Tu tomatodo, tu estilo 🎀💖 Llévatelo contigo a todas partes 🌷🩷 Escríbenos para pedir el tuyo.',
    platform: 'instagram',
    postUrl: 'https://www.instagram.com/p/DdIXOkLDUIK/',
    imageUrl: '/images/libreta1.png',
  },
  {
    title: 'Detrás de Cámaras & Taller',
    desc: 'Grabado con anillado dorado y preparación de pedidos con amor en TikTok 🎬✨',
    platform: 'tiktok',
    postUrl: 'https://www.tiktok.com/@ovejitasorpresas',
    imageUrl: '/images/libreta2.png',
  },
  {
    title: 'Nuevas Colecciones & Regalos',
    desc: 'Conoce los nuevos sets con espejo flor en tendencia y dedicatorias especiales 💕',
    platform: 'instagram',
    postUrl: 'https://www.instagram.com/ovejitasorpresas_/',
    imageUrl: '/images/libreta3.png',
  },
  {
    title: 'Empaque Aromático con Amor',
    desc: 'Cajas perfumadas con notas suaves y tarjetas caligrafiadas hechas a mano 🎁🌸',
    platform: 'tiktok',
    postUrl: 'https://www.tiktok.com/@ovejitasorpresas',
    imageUrl: '/images/planificador1.png',
  },
];
---

{isEnabled && (
  <section class="py-16 sm:py-20 bg-gradient-to-b from-[#FAF8FB] to-[#FFFDFE] border-t border-border/70 relative overflow-hidden" id="comunidad">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Header & Social Follow Buttons -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl space-y-2.5">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink-100/80 text-secondary text-[11px] font-bold uppercase tracking-wider">
            <span>{tag}</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-ink">
            {title}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 font-light leading-relaxed">
            {subtitle}
          </p>
        </div>

        <!-- Social Action Direct Buttons -->
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          {instagramUrl && (
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] text-white text-xs font-bold shadow-soft hover:opacity-95 hover:scale-105 active:scale-95 transition-all duration-300"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Instagram {instagramHandle}</span>
            </a>
          )}

          {tiktokUrl && (
            <a
              href={tiktokUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl bg-[#010101] text-white text-xs font-bold shadow-soft hover:bg-slate-800 hover:scale-105 active:scale-95 transition-all duration-300 border border-slate-700"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.3 6.3 0 0 0 1.9-4.49V8.65a8.28 8.28 0 0 0 4.87 1.55v-3.51z"/>
              </svg>
              <span>TikTok {tiktokHandle}</span>
            </a>
          )}
        </div>
      </div>

      <!-- OPCIÓN 1: REPRODUCTORES Y EMBEDS OFICIALES EN VIVO -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        
        <!-- BLOQUE 1: INSTAGRAM EN VIVO -->
        <div class="bg-white rounded-3xl border border-border shadow-soft p-5 sm:p-7 space-y-4">
          <!-- Cabecera de la Tarjeta Instagram -->
          <div class="flex items-center justify-between pb-3 border-b border-border/70">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-[#fd5949] via-[#d6249f] to-[#285AEB] flex items-center justify-center text-white shadow-2xs">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-xs sm:text-sm text-ink">{instagramHandle}</span>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9.5px] font-bold bg-pink-100 text-secondary">
                    Oficial
                  </span>
                </div>
                <p class="text-[11px] text-slate-400">Publicación en Vivo de Instagram</p>
              </div>
            </div>

            <a
              href={rawIgPost}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[11px] font-bold text-primary hover:underline inline-flex items-center gap-1"
            >
              <span>Abrir en Instagram</span>
              <span>↗</span>
            </a>
          </div>

          <!-- Embed de Instagram en Vivo -->
          <div class="w-full flex justify-center bg-slate-50/50 rounded-2xl p-1 sm:p-2 border border-slate-100 min-h-[480px]">
            <iframe
              src={instagramEmbedUrl}
              class="w-full max-w-[480px] h-[520px] sm:h-[560px] rounded-xl border-0 shadow-2xs bg-white"
              scrolling="no"
              allowtransparency="true"
              loading="lazy"
              title="Instagram Post Ovejita Sorpresas"
            ></iframe>
          </div>

          <!-- Pie con enlace al perfil -->
          <div class="pt-1 flex items-center justify-between">
            <span class="text-[11px] text-slate-500">¿Quieres ver más fotos de nuestras creaciones?</span>
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold text-primary hover:text-primary-dark transition-colors inline-flex items-center gap-1"
            >
              <span>Ver perfil completo ({instagramHandle})</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- BLOQUE 2: TIKTOK EN VIVO -->
        <div class="bg-white rounded-3xl border border-border shadow-soft p-5 sm:p-7 space-y-4">
          <!-- Cabecera de la Tarjeta TikTok -->
          <div class="flex items-center justify-between pb-3 border-b border-border/70">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-black flex items-center justify-center text-white shadow-2xs border border-slate-700">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.3 6.3 0 0 0 1.9-4.49V8.65a8.28 8.28 0 0 0 4.87 1.55v-3.51z"/>
                </svg>
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-xs sm:text-sm text-ink">{tiktokHandle}</span>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9.5px] font-bold bg-slate-900 text-white">
                    TikTok Oficial
                  </span>
                </div>
                <p class="text-[11px] text-slate-400">Videos & Detrás de Cámaras</p>
              </div>
            </div>

            <a
              href={tiktokUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[11px] font-bold text-slate-800 hover:text-black hover:underline inline-flex items-center gap-1"
            >
              <span>Abrir en TikTok</span>
              <span>↗</span>
            </a>
          </div>

          <!-- Embed de TikTok en Vivo con Fallback Interactivo -->
          <div class="w-full flex flex-col justify-center items-center bg-slate-50/50 rounded-2xl p-2 sm:p-4 border border-slate-100 min-h-[480px]">
            <blockquote
              class="tiktok-embed"
              cite={tiktokData.url}
              data-unique-id={tiktokData.uniqueId}
              data-embed-from="oembed"
              data-embed-type={tiktokData.type}
              style="max-width: 100%; min-width: 288px; width: 100%;"
            >
              <section class="p-6 text-center space-y-3 bg-white rounded-2xl border border-slate-200 shadow-xs">
                <div class="w-14 h-14 mx-auto rounded-full bg-black flex items-center justify-center text-white">
                  <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.3 6.3 0 0 0 1.9-4.49V8.65a8.28 8.28 0 0 0 4.87 1.55v-3.51z"/>
                  </svg>
                </div>
                <h4 class="font-bold text-sm text-ink">{tiktokHandle}</h4>
                <p class="text-xs text-slate-500 font-light max-w-sm mx-auto">
                  Mira cómo armamos cada libreta, los empaques aromáticos y sorpresas en TikTok.
                </p>
                <div class="pt-2">
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href={`${tiktokData.url}?refer=creator_embed`}
                    class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-black text-white text-xs font-bold hover:bg-slate-800 transition-all shadow-xs hover:scale-105"
                  >
                    <span>Ver videos en @{tiktokData.uniqueId}</span>
                    <span>→</span>
                  </a>
                </div>
              </section>
            </blockquote>
          </div>

          <!-- Pie con enlace al perfil de TikTok -->
          <div class="pt-1 flex items-center justify-between">
            <span class="text-[11px] text-slate-500">¿Te gustan los videos de procesos y empaques?</span>
            <a
              href={tiktokUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold text-ink hover:text-primary transition-colors inline-flex items-center gap-1"
            >
              <span>Seguir en TikTok ({tiktokHandle})</span>
              <span>→</span>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Official Embed Scripts for Live Interactivity -->
    <script async src="//www.instagram.com/embed.js"></script>
    <script async src="https://www.tiktok.com/embed.js"></script>
  </section>
)}

