---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Toast from '../../components/Toast.astro';
import { getProductBySlug, getSettings, getProducts } from '../../lib/api';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const [product, settings] = await Promise.all([
  getProductBySlug(slug as string),
  getSettings(),
]);

if (!product) {
  return Astro.redirect('/');
}

const primaryImage = product.primaryImage?.url || product.images?.[0]?.url || "/images/LOGO.jpg";
const formattedPrice = Number(product.finalPrice || product.price).toFixed(2);
const formattedPrevPrice = product.previousPrice ? Number(product.previousPrice).toFixed(2) : null;
const whatsappNumber = settings?.whatsappNumber || "986951425";
const isDigital = product.productType === 'DIGITAL' || product.category?.slug === 'disenos-digitales';

const waMessage = encodeURIComponent(
  isDigital
    ? `Hola Ovejita Sorpresas 🌸, deseo adquirir el diseño digital en PDF: "${product.name}" (S/ ${formattedPrice})`
    : `Hola Ovejita Sorpresas 🌸, deseo información sobre este producto: "${product.name}" (S/ ${formattedPrice})`
);
const waLink = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<MainLayout title={`${product.name} | Ovejita Sorpresas`} settings={settings}>
  <Header settings={settings} />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="text-xs text-slate-400 mb-8 flex items-center gap-2">
      <a href="/" class="hover:text-primary">Inicio</a>
      <span>/</span>
      <a href="/#catalogo" class="hover:text-primary">Catálogo</a>
      <span>/</span>
      <span class="text-ink font-semibold">{product.name}</span>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14 items-start">
      <!-- Gallery Column -->
      <div class="space-y-4">
        <div class="relative overflow-hidden rounded-3xl aspect-[4/5] bg-white border border-border shadow-soft">
          <img
            id="mainImage"
            src={primaryImage}
            alt={product.name}
            class="w-full h-full object-cover object-center"
          />
          {isDigital ? (
            <span class="absolute top-4 left-4 bg-emerald-600 text-white text-xs font-brand font-bold uppercase px-3.5 py-1 rounded-full shadow-xs flex items-center gap-1.5">
              <span>📄</span>
              <span>Descarga en PDF</span>
            </span>
          ) : product.featured && (
            <span class="absolute top-4 left-4 bg-white/95 backdrop-blur-sm border border-secondary/30 text-primary text-xs font-brand font-bold uppercase px-3.5 py-1 rounded-full shadow-xs">
              ⭐ Destacado
            </span>
          )}
        </div>

        <!-- Thumbnails if multiple images -->
        {product.images?.length > 1 && (
          <div class="flex gap-3 overflow-x-auto no-scrollbar pb-2">
            {product.images.map((img: any) => (
              <button
                type="button"
                class="w-16 h-16 rounded-xl overflow-hidden border border-border shrink-0 focus:ring-2 focus:ring-primary"
                onclick={`document.getElementById('mainImage').src = '${img.url}'`}
              >
                <img src={img.url} alt="" class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Details Column -->
      <div class="space-y-6">
        <div>
          <span class="text-xs uppercase font-bold tracking-widest text-primary block mb-1">
            {product.category?.name || "Colección Especial"}
          </span>
          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-ink leading-tight">
            {product.name}
          </h1>
          <div class="flex items-baseline gap-3 mt-3">
            <span class="text-2xl font-bold text-primary">
              S/ {formattedPrice}
            </span>
            {formattedPrevPrice && (
              <span class="text-sm text-slate-400 line-through">
                S/ {formattedPrevPrice}
              </span>
            )}
          </div>
        </div>

        <p class="text-sm text-slate-600 leading-relaxed font-light">
          {product.description || product.shortDescription}
        </p>

        <!-- Spec Pills -->
        <div class="space-y-2 pt-2 border-t border-border">
          {isDigital ? (
            <>
              <div class="flex items-center gap-2 text-xs text-slate-700">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Archivo PDF en alta resolución (300 DPI listo para imprimir)</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-700">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Adaptable a tamaños A4 y A5 sin perder nitidez</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-700">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Entrega digital inmediata sin costo de envío ni esperas</span>
              </div>
            </>
          ) : (
            <>
              <div class="flex items-center gap-2 text-xs text-slate-600">
                <svg class="w-3.5 h-3.5 text-primary shrink-0 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Hojas Bond 90g resistentes a plumas y resaltadores</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-600">
                <svg class="w-3.5 h-3.5 text-primary shrink-0 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Anillado wire-o oro de apertura 360°</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-600">
                <svg class="w-3.5 h-3.5 text-primary shrink-0 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Empaque de regalo y dedicatoria caligrafiada gratis</span>
              </div>
            </>
          )}
        </div>

        <!-- Banner de entrega digital e informe de prueba -->
        {isDigital && (
          <div class="p-4 rounded-2xl bg-emerald-50/80 border border-emerald-200 text-emerald-900 space-y-2 text-xs">
            <div class="flex items-center gap-2 font-bold text-emerald-800 font-brand">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span>Descarga Inmediata tras Confirmar Pago</span>
            </div>
            <p class="text-[11.5px] text-emerald-700 leading-relaxed font-light">
              Al adquirir este diseño recibirás el archivo digital en PDF para imprimirlo en casa o en tu imprenta favorita tantas veces como desees.
            </p>
            {product.digitalFileUrl && (
              <div class="pt-1 flex items-center gap-2">
                <a
                  href={product.digitalFileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-[11px] font-bold shadow-2xs transition-colors font-brand"
                >
                  <svg class="w-3.5 h-3.5 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>Ver / Probar PDF ({product.digitalFileName || 'Archivo PDF'})</span>
                  <span>→</span>
                </a>
              </div>
            )}
          </div>
        )}

        <!-- Action CTAs -->
        <div class="space-y-2.5 pt-4">
          {isDigital ? (
            <button
              type="button"
              class="open-digital-checkout-btn w-full py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-2xl transition-all shadow-soft flex items-center justify-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-95"
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-price={product.finalPrice || product.price}
              data-product-img={primaryImage}
              data-product-file={product.digitalFileUrl || '/uploads/pdfs/test-diseno.pdf'}
              data-product-filename={product.digitalFileName || 'diseno-imprimible.pdf'}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Comprar Diseño en PDF · S/ {formattedPrice}</span>
            </button>
          ) : (
            <button
              type="button"
              class="add-to-bag-btn w-full py-4 bg-primary hover:bg-primary-dark text-white font-bold text-xs rounded-2xl transition-all shadow-soft flex items-center justify-center gap-2 cursor-pointer active:scale-95"
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-price={product.finalPrice || product.price}
              data-product-img={primaryImage}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>Añadir a mi pedido</span>
            </button>
          )}

          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-800 font-bold text-xs rounded-2xl transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer"
            title="Deseo información sobre este producto por WhatsApp"
          >
            <svg class="w-4 h-4 fill-emerald-600" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
            </svg>
            <span>💬 Deseo información sobre este producto</span>
          </a>

          <a
            href="/#catalogo"
            class="w-full py-3 bg-white border border-border text-ink hover:bg-primary-soft font-semibold text-xs rounded-2xl transition-colors flex items-center justify-center"
          >
            ← Volver al catálogo
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer settings={settings} />
  <WhatsAppButton whatsappNumber={whatsappNumber} />
  <Toast />
</MainLayout>
